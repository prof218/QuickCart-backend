# ---- QuickCart backend environment ----
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# Port the API server listens on
PORT=5000

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/quickcart
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/quickcart?retryWrites=true&w=majority
MONGODB_URI=

# Allowed browser origin for CORS (your Next.js app)
FRONTEND_URL=http://localhost:3000

# Razorpay TEST-mode API keys (Dashboard → Settings → API Keys).
# RAZORPAY_KEY_ID is public (sent to the browser); RAZORPAY_KEY_SECRET must stay server-side only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Authentication ----
# Secret used to sign JWT session cookies. Use a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=
# How long a session lasts (zeit/ms format). Optional.
JWT_EXPIRES_IN=7d
# Cookie names (optional overrides).
AUTH_COOKIE_NAME=qc_token
CSRF_COOKIE_NAME=qc_csrf
# Secure cookies. Leave unset to auto-enable in production; set false for plain-HTTP local dev.
# COOKIE_SECURE=false

# Optional: node environment
NODE_ENV=development
